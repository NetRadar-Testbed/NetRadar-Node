# Template for the NetRadar node service. install.sh fills in @REPO_DIR@ and
# @USER_HOME@ and installs the result as /etc/systemd/system/netradar-node.service.
[Unit]
Description=NetRadar node launcher
Documentation=https://netradar-testbed.github.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root is needed for GPIO triggering and DCA1000/radar setup scripts.
User=root
Group=root
Environment=NODE_DIR=@REPO_DIR@
Environment=HOME=@USER_HOME@
WorkingDirectory=@REPO_DIR@
ExecStart=@REPO_DIR@/.venv/bin/python3 @REPO_DIR@/src/node_launcher.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=netradar-node

# Security hardening. With ProtectSystem=strict every path listed in
# ReadWritePaths must already exist (install.sh creates logs/).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp @REPO_DIR@/logs @REPO_DIR@/src @REPO_DIR@/scripts @REPO_DIR@/setup_radar @REPO_DIR@/DCA1000
ReadOnlyPaths=@REPO_DIR@/.env

[Install]
WantedBy=multi-user.target
