# NetRadar node configuration.
#
# You normally do NOT edit this by hand: run ./configure.sh and paste the
# block that the fusion center's setup.sh printed for this node. configure.sh
# writes .env (git-ignored, readable only by you and root).
#
# If you do create .env manually, copy this file and fill in every value.

# Fusion center (MQTT broker) — its Tailscale name or IP address.
MQTT_HOST=<fusion-center-host>
MQTT_PORT=1883

# This node's identity and MQTT credentials (from the fusion center's setup.sh).
NODE_ID=<node-id>
MQTT_USERNAME=<node-id>
MQTT_PASSWORD=<generated-by-fusion-center-setup>
MQTT_CLIENT_ID=radar-<node-id>
GROUP_ID=default

# Protocol (must match the fusion center).
NETRADAR_SCHEMA_VERSION=1
NETRADAR_TOPIC_PREFIX=netradar/v1

# Hardware trigger: "mqtt" (synchronized with other nodes) or "local" (single node).
NETRADAR_TRIGGER_MODE=mqtt

# Address the node's web pages (visualizer :5001, logs :5003) listen on.
# configure.sh sets this to the node's Tailscale IP so they are only reachable
# from your own tailnet. 0.0.0.0 = every interface.
UI_BIND_HOST=0.0.0.0
LOG_PORT=5003
